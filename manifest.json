{
  "manifest_version": 3,
  "name": "X 转发卡片",
  "version": "0.2.0",
  "description": "把推文（含中文翻译和你勾选的评论）生成双语长图或网页，方便转发到微信",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://pbs.twimg.com/*",
    "https://video.twimg.com/*",
    "https://abs.twimg.com/*",
    "https://api.deepseek.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": [
        "vendor/html2canvas.min.js",
        "src/content/extract.js",
        "src/content/redact.js",
        "src/content/card.js",
        "src/content/webpage.js",
        "src/content/content.js"
      ],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options/options.html",
  "action": {
    "default_title": "X 转发卡片 · 打开设置"
  }
}
