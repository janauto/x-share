{
  "manifest_version": 3,
  "name": "X 转发卡片",
  "version": "0.3.0",
  "description": "把推文（含中文翻译和你勾选的评论）生成双语长图或网页，方便转发到微信。新版长图跟随 X 主题、提供 X 原生截图风皮肤。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "alarms", "unlimitedStorage"],
  "host_permissions": [
    "https://pbs.twimg.com/*",
    "https://video.twimg.com/*",
    "https://abs.twimg.com/*",
    "https://api.deepseek.com/*",
    "https://api.github.com/*",
    "https://*.tcloudbase.com/*",
    "https://*.tcloudbaseapp.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "//content_scripts_order": "加载顺序是路线A的生命线，须按依赖序：shared(纯逻辑) → extract/redact(数据) → render(发射器) → ui/pipeline → content(编排)。顺序错误 = 白屏级故障。",
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": [
        "vendor/html2canvas.min.js",
        "src/shared/config-schema.js",
        "src/shared/fmt.js",
        "src/shared/theme.js",
        "src/shared/blocks.js",
        "src/shared/ir.js",
        "src/shared/rpc.js",
        "src/content/extract.js",
        "src/content/redact.js",
        "src/content/render/emit-card.js",
        "src/content/render/emit-page.js",
        "src/content/render/emit-rich.js",
        "src/content/render/emit-text.js",
        "src/content/render/raster.js",
        "src/content/ui/widgets.js",
        "src/content/pipeline.js",
        "src/content/content.js"
      ],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://docs.qq.com/*"],
      "js": ["src/shared/fmt.js", "src/content/txdocs.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options/options.html",
  "action": {
    "default_title": "X 转发卡片 · 打开设置"
  }
}
